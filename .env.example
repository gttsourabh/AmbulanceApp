# ==============================================================================
# SECURE AMBULANCE APP - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and fill in the values for your local environment:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="Secure Ambulance"
APP_PACKAGE_NAME=com.secureambulance

# ------------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION
# ------------------------------------------------------------------------------
API_BASE_URL=https://arvaya.uvtechsoft.com:7001
API_BASE_URL_DEV_BAHUBALI=https://your-dev-tunnel.devtunnels.ms
API_BASE_URL_DEV_PRANALI=https://your-dev-tunnel.devtunnels.ms
API_KEY=your_api_key_here
API_TIMEOUT=15000

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD & MAPS API CONFIGURATION
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_ROUTES_API_URL=https://routes.googleapis.com/directions/v2:computeRoutes
GOOGLE_PLACES_SEARCH_TEXT_URL=https://places.googleapis.com/v1/places:searchText
GOOGLE_PLACES_SEARCH_NEARBY_URL=https://places.googleapis.com/v1/places:searchNearby

# ------------------------------------------------------------------------------
# 4. FIREBASE CLOUD MESSAGING (FCM) & SERVICES
# ------------------------------------------------------------------------------
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PROJECT_NUMBER=your_firebase_project_number
FIREBASE_STORAGE_BUCKET=your_storage_bucket.firebasestorage.app
FIREBASE_APP_ID=your_firebase_mobile_app_id

# ------------------------------------------------------------------------------
# 5. ANDROID RELEASE KEYSTORE SIGNING
# ------------------------------------------------------------------------------
MYAPP_UPLOAD_STORE_FILE=secure-ambulance-upload-key.keystore
MYAPP_UPLOAD_KEY_ALIAS=secure-ambulance
MYAPP_UPLOAD_STORE_PASSWORD=your_store_password
MYAPP_UPLOAD_KEY_PASSWORD=your_key_password
